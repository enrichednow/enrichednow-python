{
  "request": {
    "method": "POST",
    "path": "/v1/formulas/job-order-hunter/runs",
    "headers": {
      "Idempotency-Key": "c0ffee-cap"
    },
    "body": {
      "params": {
        "job_titles": [
          "Java Developer"
        ],
        "locations": [
          "London"
        ],
        "posted_within_days": 2,
        "title_exclude_keywords": [
          "intern"
        ],
        "exclude_companies": [
          "Blocked By Us Inc"
        ],
        "company_size": {
          "min": 11,
          "max": 5000
        }
      },
