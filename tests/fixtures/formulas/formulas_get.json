      "version": "1.1.0",
      "title": "Job Order Hunter",
      "summary": "Companies newly hiring for your roles and places, qualified by size and industry, with the person to contact.",
      "use_when": "Use when a recruiter wants companies hiring for given roles in given places, with someone to call about the job.",
      "category": "recruiting",
      "personas": [
        "recruiter",
        "research_analyst",
        "staffing_agency"
      ],
      "status": "beta",
      "available": true,
      "needs_provider": true,
      "recommended_cadence": "weekdays",
      "schedules": [
        "daily",
        "weekdays",
        "weekly"
      ],
      "needs_attestation": true,
      "health": {
        "status": "ok",
        "degraded_sources": [],
        "success_rate_7d": null,
        "median_seconds_7d": null
      },
      "basics": [
        {
          "name": "job_titles",
          "title": "Job titles",
          "type": "list of strings",
          "required": true,
          "help": "The roles you recruit for, each searched as you type it."
        },
        {
          "name": "locations",
          "title": "Locations",
          "type": "list of strings",
          "required": true,
          "help": "A city, region or country for each place you cover."
        },
        {
          "name": "posted_within_days",
          "title": "Posted within (days)",
          "type": "integer",
          "required": false,
          "help": "Only jobs posted in the last this many days."
        }
      ],
      "description": "Finds the companies that posted the roles you recruit for, in the places you cover, across the job boards and, when you name target companies, their own careers pages. Each company is matched to its website, sized up and checked against your exclusions; staffing agencies are left out. A company whose own careers page lists the role ranks higher. The result is one row for each company, job and contact, best first, and can be read one row per company.",
